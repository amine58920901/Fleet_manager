generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  settings  OrganizationSettings?
  vehicles  Vehicle[]
  drivers   Driver[]
  quotes    Quote[]
  invoices  Invoice[]
  contracts Contract[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  hashedPassword String?
  role           Role         @default(USER)
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  accounts Account[]
  sessions Session[]
}

enum Role {
  ADMIN
  USER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model OrganizationSettings {
  id               String       @id @default(cuid())
  // Identité visuelle documents
  primaryColor     String       @default("#2563eb")
  secondaryColor   String       @default("#1e40af")
  accentColor      String       @default("#eff6ff")
  documentFont     String       @default("Helvetica")
  logoBase64       String?      @db.Text
  // Informations société
  companyName      String?
  legalForm        String?
  siret            String?
  vatNumber        String?
  companyAddress   String?
  companyCity      String?
  companyZip       String?
  companyCountry   String?      @default("France")
  companyPhone     String?
  companyEmail     String?
  companyWebsite   String?
  updatedAt        DateTime     @updatedAt
  organizationId   String       @unique
  organization     Organization @relation(fields: [organizationId], references: [id])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Vehicle {
  id             String        @id @default(cuid())
  brand          String
  model          String
  year           Int
  licensePlate   String        @unique
  vin            String?       @unique
  color          String?
  mileage        Int           @default(0)
  status         VehicleStatus @default(AVAILABLE)
  dailyRate      Decimal       @db.Decimal(10, 2)
  weeklyRate     Decimal?      @db.Decimal(10, 2)
  monthlyRate    Decimal?      @db.Decimal(10, 2)
  depositAmount  Decimal?      @db.Decimal(10, 2)
  imageUrl       String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  contracts Contract[]
}

enum VehicleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  OUT_OF_SERVICE
}

model Driver {
  id             String       @id @default(cuid())
  firstName      String
  lastName       String
  email          String?
  phone          String?
  licenseNumber  String       @unique
  licenseExpiry  DateTime?
  birthDate      DateTime?
  address        String?
  photoUrl       String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  contracts Contract[]
}

model Quote {
  id             String       @id @default(cuid())
  number         String       @unique
  status         QuoteStatus  @default(DRAFT)
  clientName     String
  clientEmail    String?
  clientPhone    String?
  clientAddress  String?
  startDate      DateTime
  endDate        DateTime
  vehicleId      String?
  vehicleDesc    String
  rateType       String       @default("DAILY")
  dailyRate      Decimal      @db.Decimal(10, 2)
  days           Int
  subtotal       Decimal      @db.Decimal(10, 2)
  discountType   String       @default("PERCENT")
  discountValue  Decimal      @db.Decimal(10, 2) @default(0)
  discountAmount Decimal      @db.Decimal(10, 2) @default(0)
  taxRate        Decimal      @db.Decimal(5, 2) @default(20)
  taxAmount           Decimal      @db.Decimal(10, 2)
  total               Decimal      @db.Decimal(10, 2)
  billingMode         String       @default("FULL")
  installmentAmount   Decimal?     @db.Decimal(10, 2)
  totalInstallments   Int?
  notes          String?
  validUntil     DateTime?
  pdfUrl         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  invoices Invoice[]
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REFUSED
  EXPIRED
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  status         InvoiceStatus @default(UNPAID)
  clientName     String
  clientEmail    String?
  clientPhone    String?
  clientAddress  String?
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  subtotal       Decimal       @db.Decimal(10, 2)
  taxRate        Decimal       @db.Decimal(5, 2) @default(19)
  taxAmount      Decimal       @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  installmentNumber   Int?
  totalInstallments   Int?
  notes          String?
  pdfUrl         String?
  quoteId        String?
  quote          Quote?        @relation(fields: [quoteId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  contract Contract?
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

model Contract {
  id             String         @id @default(cuid())
  number         String         @unique
  status         ContractStatus @default(ACTIVE)
  startDate      DateTime
  endDate        DateTime
  returnedAt     DateTime?
  depositAmount  Decimal?       @db.Decimal(10, 2)
  mileageStart   Int?
  mileageEnd     Int?
  fuelLevelStart  String?
  fuelLevelEnd    String?
  conditionStart  Json?
  conditionEnd    Json?
  terms           String?
  // Modalités financières
  paymentAmount             Decimal?  @db.Decimal(10, 2)
  paymentTaxType            String?
  paymentDueDay             Int?
  paymentMethod             String?
  depositReturnConditions   String?
  // Usage kilométrique
  mileageAllowance          Int?
  extraMileageCost          Decimal?  @db.Decimal(10, 2)
  // Assurance & entretien
  insuranceFranchise        Decimal?  @db.Decimal(10, 2)
  insuranceInfo             String?
  maintenanceInfo           String?
  // Résiliation & restitution
  returnLocation            String?
  earlyTerminationConditions String?
  pdfUrl         String?
  quoteId        String?        @unique
  vehicleId      String
  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id])
  driverId       String
  driver         Driver         @relation(fields: [driverId], references: [id])
  invoiceId      String?        @unique
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}
